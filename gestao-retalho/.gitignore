# Go
/build/
*.test

# Wails build output and generated bindings (regenerated by `wails build`/`wails dev`)
cmd/*/build/bin/
cmd/*/frontend/wailsjs/

# Frontend
cmd/*/frontend/node_modules/
cmd/*/frontend/dist/

# SQLite (loja data never belongs in git)
*.db
*.db-wal
*.db-shm

# Editors / OS
.DS_Store

# Instalador Windows: o bootstrapper do WebView2 que o Wails descarrega
cmd/*/build/windows/installer/tmp/

# Instaladores e pacotes gerados para entregar
/dist/

# Build do frontend para a WebView do Android (vite --mode android)
cmd/*/frontend/dist-android/

# Android (cmd/android)
cmd/android/.gradle/
cmd/android/**/build/
cmd/android/local.properties
cmd/android/app/src/main/assets/web/
cmd/android/app/libs/*.aar
*.jks
